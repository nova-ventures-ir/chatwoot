<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body>
<form id="sso" method="post" action="<%= request.path %>">
  <% @sso_fields.each do |name, value| %>
    <input type="hidden" name="<%= name %>" value="<%= h(value) %>">
  <% end %>
</form>
<script>document.getElementById("sso").submit()</script>
</body>
</html>